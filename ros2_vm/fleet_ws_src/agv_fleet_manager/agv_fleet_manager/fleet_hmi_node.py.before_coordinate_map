    def reset_all(self) -> None:
        confirmed = self.confirm(
            "Reset all robots",
            (
                "Reset E-stop/fault state "
                "on ALL AGVs?\n\n"
                "Confirm the complete operating "
                "area is safe."
            ),
            critical=True,
        )

        if confirmed:
            self.ros_node.reset(
                "all"
            )


def load_config() -> dict:
    share_directory = Path(
        get_package_share_directory(
            "agv_fleet_manager"
        )
    )

    config_path = (
        share_directory
        / "config"
        / "fleet_config.json"
    )

    return json.loads(
        config_path.read_text(
            encoding="utf-8"
        )
    )


def main(args=None) -> None:
    rclpy.init(args=args)

    ros_node = FleetHMINode()

    app = QApplication(
        sys.argv
    )

    app.setApplicationName(
        "Industrial AGV Fleet Control"
    )

    window = FleetHMI(
        ros_node,
        load_config(),
    )

    window.showMaximized()

    exit_code = app.exec_()

    ros_node.destroy_node()
    rclpy.shutdown()

    sys.exit(
        exit_code
    )


if __name__ == "__main__":
    main()
