class FleetHMINode(Node):
    def __init__(self) -> None:
        super().__init__(
            "fleet_hmi_node"
        )

        self.status = {}
        self.reservations = {}
        self.queue = []
        self.events: List[str] = []

        self.create_subscription(
            String,
            "/fleet/status",
            self.status_callback,
            10,
        )

        self.create_subscription(
            String,
            "/fleet/reservations",
            self.reservations_callback,
            10,
        )

        self.create_subscription(
            String,
            "/fleet/queue",
            self.queue_callback,
            10,
        )

        self.create_subscription(
            String,
            "/fleet/event",
            self.event_callback,
            10,
        )

        self.dispatch_pub = (
            self.create_publisher(
                String,
                "/fleet/dispatch",
                10,
            )
        )

        self.cancel_pub = (
            self.create_publisher(
                String,
                "/fleet/cancel",
                10,
            )
        )

        self.resume_pub = (
            self.create_publisher(
                String,
                "/fleet/resume",
                10,
            )
        )

        self.set_node_pub = (
            self.create_publisher(
                String,
                "/fleet/set_current_node",
                10,
            )
        )

        self.estop_pub = (
            self.create_publisher(
                String,
                "/fleet/estop",
                10,
            )
        )

        self.reset_pub = (
            self.create_publisher(
                String,
                "/fleet/reset",
                10,
            )
        )

    def status_callback(
        self,
        msg: String,
    ) -> None:
        try:
            self.status = json.loads(
                msg.data
            )
        except Exception:
            pass

    def reservations_callback(
        self,
        msg: String,
    ) -> None:
        try:
            self.reservations = (
                json.loads(
                    msg.data
                )
            )
        except Exception:
            pass

    def queue_callback(
        self,
        msg: String,
    ) -> None:
        try:
            self.queue = json.loads(
                msg.data
            )
        except Exception:
            pass

    def event_callback(
        self,
        msg: String,
    ) -> None:
        timestamp = time.strftime(
            "%Y-%m-%d %H:%M:%S"
        )

        self.events.append(
            f"[{timestamp}] {msg.data}"
        )

        self.events = (
            self.events[-1000:]
        )

    @staticmethod
    def publish_json(
        publisher,
        payload: dict,
    ) -> None:
        msg = String()
        msg.data = json.dumps(
            payload
        )
        publisher.publish(msg)

    def dispatch(
        self,
        robot: str,
        destination: str,
    ) -> None:
        self.publish_json(
            self.dispatch_pub,
            {
                "robot": robot,
                "destination":
                    destination,
            },
        )

    def cancel(
        self,
        robot: str,
    ) -> None:
        self.publish_json(
            self.cancel_pub,
            {
                "robot": robot,
            },
        )

    def resume(
        self,
        robot: str,
    ) -> None:
        self.publish_json(
            self.resume_pub,
            {
                "robot": robot,
            },
        )

    def set_node(
        self,
        robot: str,
        node: str,
    ) -> None:
        self.publish_json(
            self.set_node_pub,
            {
                "robot": robot,
                "node": node,
            },
        )

    def estop(
        self,
        robot: str,
    ) -> None:
        self.publish_json(
            self.estop_pub,
            {
                "robot": robot,
            },
        )

    def reset(
        self,
        robot: str,
    ) -> None:
        self.publish_json(
            self.reset_pub,
            {
                "robot": robot,
            },
        )


class TrackView(QGraphicsView):
    ROBOT_COLORS = {
        "agv_1":
            QColor("#26a7ff"),

        "agv_2":
            QColor("#ff9f1c"),
    }

    def __init__(
        self,
        config: dict,
    ) -> None:
        super().__init__()

        self.config = config

        self.track_scene = (
            QGraphicsScene(self)
        )

        self.setScene(
            self.track_scene
        )

        self.setRenderHint(
            QPainter.Antialiasing
        )

        self.setBackgroundBrush(
            QColor("#0b1016")
        )

        self.setMinimumHeight(390)

        self.setDragMode(
            QGraphicsView.ScrollHandDrag
        )

        self.edge_items: Dict[
            tuple,
            QGraphicsLineItem,
        ] = {}

        self.robot_items: Dict[
            str,
            QGraphicsEllipseItem,
        ] = {}

        self.robot_labels: Dict[
            str,
            QGraphicsTextItem,
        ] = {}

        self.build_graph()

    def point(
        self,
        node_name: str,
    ) -> QPointF:
        info = self.config[
            "nodes"
        ][node_name]

        return QPointF(
            float(info["x"]),
            float(info["y"]),
        )

    @staticmethod
    def edge_key(
        node_a: str,
        node_b: str,
    ) -> tuple:
        return tuple(
            sorted(
                (
                    node_a,
                    node_b,
                )
            )
        )

    def build_graph(self) -> None:
        default_pen = QPen(
            QColor("#465566"),
            4,
        )

        for (
            node_a,
            node_b,
        ) in self.config[
            "connections"
        ]:
            point_a = self.point(
                node_a
            )

            point_b = self.point(
                node_b
            )

            line = (
                self.track_scene.addLine(
                    point_a.x(),
                    point_a.y(),
                    point_b.x(),
                    point_b.y(),
                    default_pen,
                )
            )

            line.setZValue(1)

            self.edge_items[
                self.edge_key(
                    node_a,
                    node_b,
                )
            ] = line

        for (
            node_name,
            info,
        ) in self.config[
            "nodes"
        ].items():
            point = self.point(
                node_name
            )

            node_type = info.get(
                "type",
                "junction",
            )

            radius = (
                10
                if node_type
                == "junction"
                else 14
            )

            fill_color = (
                QColor("#d8dee9")
                if node_type
                == "junction"
                else QColor("#8aa4bf")
            )

            node_item = (
                self.track_scene.addEllipse(
                    point.x() - radius,
                    point.y() - radius,
                    radius * 2,
                    radius * 2,
                    QPen(
                        QColor("#101820"),
                        2,
                    ),
                    QBrush(fill_color),
                )
            )

            node_item.setZValue(3)

            label = (
                self.track_scene.addText(
                    node_name
                )
            )

            label.setDefaultTextColor(
                QColor("#e6edf3")
            )

            label.setFont(
                QFont(
                    "DejaVu Sans",
                    9,
                    QFont.Bold,
                )
            )

            label.setPos(
                point.x() + 12,
                point.y() - 24,
            )

            label.setZValue(4)

        for robot_name in (
            "agv_1",
            "agv_2",
        ):
            color = self.ROBOT_COLORS[
                robot_name
            ]

            robot_item = (
                self.track_scene.addEllipse(
                    -11,
                    -11,
                    22,
                    22,
                    QPen(
                        QColor("#ffffff"),
                        2,
                    ),
                    QBrush(color),
                )
            )

            robot_item.setVisible(
                False
            )

            robot_item.setZValue(10)

            self.robot_items[
                robot_name
            ] = robot_item

            label = (
                self.track_scene.addText(
                    robot_name.upper()
                )
            )

            label.setDefaultTextColor(
                color
            )

            label.setFont(
                QFont(
                    "DejaVu Sans",
                    9,
                    QFont.Bold,
                )
            )

            label.setVisible(False)
            label.setZValue(11)

            self.robot_labels[
                robot_name
            ] = label

        scene_rect = (
            self.track_scene
            .itemsBoundingRect()
            .adjusted(
                -60,
                -60,
                100,
                100,
            )
        )

        self.track_scene.setSceneRect(
            scene_rect
        )

        self.fitInView(
            scene_rect,
            Qt.KeepAspectRatio,
        )

    def resizeEvent(
        self,
        event,
    ) -> None:
        super().resizeEvent(
            event
        )

        self.fitInView(
            self.track_scene.sceneRect(),
            Qt.KeepAspectRatio,
        )

    def update_fleet(
        self,
        status: dict,
        reservations: dict,
    ) -> None:
        default_pen = QPen(
            QColor("#465566"),
            4,
        )

        for edge_item in (
            self.edge_items.values()
        ):
            edge_item.setPen(
                default_pen
            )

        for (
            robot_name,
            reservation,
        ) in reservations.items():
            color = (
                self.ROBOT_COLORS.get(
                    robot_name,
                    QColor("#b388ff"),
                )
            )

            reservation_pen = QPen(
                color,
                8,
            )

            reservation_pen.setCapStyle(
                Qt.RoundCap
            )

            path = reservation.get(
                "path",
                [],
            )

            for index in range(
                len(path) - 1
            ):
                key = self.edge_key(
                    path[index],
                    path[index + 1],
                )

                edge_item = (
                    self.edge_items.get(
                        key
                    )
                )

                if edge_item is not None:
                    edge_item.setPen(
                        reservation_pen
                    )

        robots = status.get(
            "robots",
            {},
        )

        for (
            robot_name,
            robot_item,
        ) in self.robot_items.items():
            robot_data = robots.get(
                robot_name,
                {},
            )

            current_node = (
                robot_data.get(
                    "current_node",
                    "",
                )
            )

            if (
                current_node
                not in self.config["nodes"]
            ):
                robot_item.setVisible(
                    False
                )

                self.robot_labels[
                    robot_name
                ].setVisible(False)

                continue

            point = self.point(
                current_node
            )

            offset = (
                -13
                if robot_name
                == "agv_1"
                else 13
            )

            robot_item.setPos(
                point.x() + offset,
                point.y(),
            )

            robot_item.setVisible(
                True
            )

            label = self.robot_labels[
                robot_name
            ]

            label.setPos(
                point.x()
                + offset
                - 23,
                point.y() + 15,
            )

            label.setVisible(
                True
            )


class RobotCard(QGroupBox):
    def __init__(
        self,
        robot_name: str,
        destination_nodes: List[str],
        all_nodes: List[str],
        main_window,
    ) -> None:
        super().__init__(
            robot_name.upper()
        )

        self.robot_name = robot_name
        self.main_window = main_window

        layout = QGridLayout(self)

        self.values: Dict[
            str,
            QLabel,
        ] = {}

        fields = [
            ("Communication", "online"),
            ("Safety", "safety"),
            ("Current node", "current_node"),
            ("Destination", "destination"),
            ("Mission", "mission"),
            ("Obstacle", "obstacle"),
            ("Safety hold", "hold"),
            ("Reservation", "reservation"),
        ]

        for (
            row,
            field,
        ) in enumerate(fields):
            label_text, key = field

            label = QLabel(
                label_text
            )

            label.setObjectName(
                "fieldLabel"
            )

            value = QLabel("-")

            value.setObjectName(
                "fieldValue"
            )

            layout.addWidget(
                label,
                row,
                0,
            )

            layout.addWidget(
                value,
                row,
                1,
            )

            self.values[key] = value

        row = len(fields)

        self.destination_combo = (
            QComboBox()
        )

        self.destination_combo.addItems(
            destination_nodes
        )

        self.dispatch_button = (
            QPushButton(
                "DISPATCH MISSION"
            )
        )

        self.dispatch_button.setObjectName(
            "primaryButton"
        )

        self.dispatch_button.clicked.connect(
            self.dispatch_clicked
        )

        layout.addWidget(
            QLabel(
                "Mission destination"
            ),
            row,
            0,
        )

        layout.addWidget(
            self.destination_combo,
            row,
            1,
        )

        layout.addWidget(
            self.dispatch_button,
            row + 1,
            0,
            1,
            2,
        )

        self.cancel_button = (
            QPushButton(
                "CANCEL"
            )
        )

        self.cancel_button.setObjectName(
            "warningButton"
        )

        self.cancel_button.clicked.connect(
            self.cancel_clicked
        )

        self.resume_button = (
            QPushButton(
                "RESUME"
            )
        )

        self.resume_button.setObjectName(
            "primaryButton"
        )

        self.resume_button.clicked.connect(
            self.resume_clicked
        )

        action_layout = QHBoxLayout()

        action_layout.addWidget(
            self.cancel_button
        )

        action_layout.addWidget(
            self.resume_button
        )

        layout.addLayout(
            action_layout,
            row + 2,
            0,
            1,
            2,
        )

        self.node_combo = QComboBox()

        self.node_combo.addItems(
            all_nodes
        )

        self.set_node_button = (
            QPushButton(
                "SET CONFIRMED NODE"
            )
        )

        self.set_node_button.setObjectName(
            "secondaryButton"
        )

        self.set_node_button.clicked.connect(
            self.set_node_clicked
        )

        layout.addWidget(
            QLabel(
                "Initialization node"
            ),
            row + 3,
            0,
        )

        layout.addWidget(
            self.node_combo,
            row + 3,
            1,
        )

        layout.addWidget(
            self.set_node_button,
            row + 4,
            0,
            1,
            2,
        )

        self.estop_button = (
            QPushButton(
                "E-STOP"
            )
        )

        self.estop_button.setObjectName(
            "dangerButton"
        )

        self.estop_button.clicked.connect(
            self.estop_clicked
        )

        self.reset_button = (
            QPushButton(
                "RESET E-STOP / FAULT"
            )
        )

        self.reset_button.setObjectName(
            "secondaryButton"
        )

        self.reset_button.clicked.connect(
            self.reset_clicked
        )

