    def spin_ros(self) -> None:
        rclpy.spin_once(
            self.ros_node,
            timeout_sec=0.0,
        )

    def refresh_ui(self) -> None:
        self.clock_label.setText(
            time.strftime(
                "%Y-%m-%d %H:%M:%S"
            )
        )

        status = self.ros_node.status

        reservations = (
            self.ros_node.reservations
        )

        robots = status.get(
            "robots",
            {},
        )

        fleet_state = status.get(
            "fleet_state",
            "STARTING",
        )

        self.fleet_state_label.setText(
            fleet_state
        )

        if fleet_state == "READY":
            state_color = "#1d7a3f"

        elif fleet_state == "ACTIVE":
            state_color = "#145ea8"

        elif fleet_state in {
            "QUEUED",
            "POSITION_UNKNOWN",
        }:
            state_color = "#8a5a12"

        else:
            state_color = "#9e1c23"

        self.fleet_state_label.setStyleSheet(
            f"background: {state_color};"
            "padding: 7px 12px;"
            "border-radius: 3px;"
            "font-weight: 800;"
        )

        for (
            robot_name,
            card,
        ) in self.robot_cards.items():
            card.update_data(
                robots.get(
                    robot_name,
                    {},
                ),
                reservations.get(
                    robot_name,
                    {},
                ),
            )

        self.track_view.update_fleet(
            status,
            reservations,
        )

        self.update_queue_table()
        self.update_reservation_table()

        event_text = "\n".join(
            self.ros_node.events
        )

        if (
            self.event_log
            .toPlainText()
            != event_text
        ):
            self.event_log.setPlainText(
                event_text
            )

            scrollbar = (
                self.event_log
                .verticalScrollBar()
            )

            scrollbar.setValue(
                scrollbar.maximum()
            )

    def update_queue_table(self) -> None:
        queue = self.ros_node.queue

        self.queue_table.setRowCount(
            len(queue)
        )

        for (
            row,
            request,
        ) in enumerate(queue):
            values = [
                request.get(
                    "robot",
                    "",
                ),
                request.get(
                    "destination",
                    "",
                ),
                request.get(
                    "request_id",
                    "",
                ),
            ]

            for (
                column,
                value,
            ) in enumerate(values):
                self.queue_table.setItem(
                    row,
                    column,
                    QTableWidgetItem(
                        str(value)
                    ),
                )

        self.queue_table.resizeColumnsToContents()

    def update_reservation_table(
        self,
    ) -> None:
        reservations = list(
            self.ros_node
            .reservations
            .items()
        )

        self.reservation_table.setRowCount(
            len(reservations)
        )

        for (
            row,
            reservation_entry,
        ) in enumerate(reservations):
            robot_name, reservation = (
                reservation_entry
            )

            values = [
                robot_name,
                reservation.get(
                    "destination",
                    "",
                ),
                " → ".join(
                    reservation.get(
                        "path",
                        [],
                    )
                ),
                reservation.get(
                    "request_id",
                    "",
                ),
            ]

            for (
                column,
                value,
            ) in enumerate(values):
                self.reservation_table.setItem(
                    row,
                    column,
                    QTableWidgetItem(
                        str(value)
                    ),
                )

        self.reservation_table.resizeColumnsToContents()

    def confirm(
        self,
        title: str,
        text: str,
        critical: bool = False,
    ) -> bool:
        box = QMessageBox(self)

        box.setWindowTitle(
            title
        )

        box.setText(
            text
        )

        box.setIcon(
            QMessageBox.Critical
            if critical
            else QMessageBox.Warning
        )

        box.setStandardButtons(
            QMessageBox.Yes
            | QMessageBox.No
        )

        box.setDefaultButton(
            QMessageBox.No
        )

        return (
            box.exec_()
            == QMessageBox.Yes
        )

    def dispatch(
        self,
        robot_name: str,
        destination: str,
    ) -> None:
        confirmed = self.confirm(
            "Confirm mission dispatch",
            (
                f"Dispatch {robot_name} "
                f"to {destination}?\n\n"
                "The fleet manager will request "
                "the route, check all occupied "
                "nodes and reservations, reserve "
                "the complete route, and queue "
                "the mission if it conflicts."
            ),
        )

        if confirmed:
            self.ros_node.dispatch(
                robot_name,
                destination,
            )

    def cancel(
        self,
        robot_name: str,
    ) -> None:
        confirmed = self.confirm(
            "Confirm mission cancellation",
            (
                f"Cancel the active or queued "
                f"mission for {robot_name}?"
            ),
        )

        if confirmed:
            self.ros_node.cancel(
                robot_name
            )

    def resume(
        self,
        robot_name: str,
    ) -> None:
        confirmed = self.confirm(
            "Confirm controlled resume",
            (
                f"Resume the safety-held "
                f"mission for {robot_name}?"
            ),
        )

        if confirmed:
            self.ros_node.resume(
                robot_name
            )

    def set_node(
        self,
        robot_name: str,
        node_name: str,
    ) -> None:
        confirmed = self.confirm(
            "Confirm physical position",
            (
                f"Confirm that {robot_name} "
                f"is physically located at "
                f"{node_name}.\n\n"
                "This changes its mission "
                "position reference."
            ),
            critical=True,
        )

        if confirmed:
            self.ros_node.set_node(
                robot_name,
                node_name,
            )

    def estop(
        self,
        robot_name: str,
    ) -> None:
        confirmed = self.confirm(
            "Emergency stop",
            (
                f"Send emergency stop "
                f"to {robot_name}?"
            ),
            critical=True,
        )

        if confirmed:
            self.ros_node.estop(
                robot_name
            )

    def reset_robot(
        self,
        robot_name: str,
    ) -> None:
        confirmed = self.confirm(
            "Reset robot",
            (
                f"Reset E-stop/fault state "
                f"for {robot_name}?\n\n"
                "Confirm the physical area "
                "is safe before resetting."
            ),
