            self.robot_name,
            self.destination_combo
            .currentText()
            .strip(),
        )

    def cancel_clicked(self) -> None:
        self.main_window.cancel(
            self.robot_name
        )

    def resume_clicked(self) -> None:
        self.main_window.resume(
            self.robot_name
        )

    def set_node_clicked(self) -> None:
        self.main_window.set_node(
            self.robot_name,
            self.node_combo
            .currentText()
            .strip(),
        )

    def estop_clicked(self) -> None:
        self.main_window.estop(
            self.robot_name
        )

    def reset_clicked(self) -> None:
        self.main_window.reset_robot(
            self.robot_name
        )

    @staticmethod
    def style_indicator(
        widget: QLabel,
        state: str,
    ) -> None:
        colors = {
            "good": "#32c766",
            "warning": "#ffb020",
            "bad": "#ff4d4f",
            "neutral": "#d0d7de",
            "blue": "#26a7ff",
        }

        color = colors.get(
            state,
            colors["neutral"],
        )

        widget.setStyleSheet(
            f"color: {color};"
            "font-weight: 700;"
        )

    def update_data(
        self,
        data: dict,
        reservation: dict,
    ) -> None:
        online = bool(
            data.get(
                "online",
                False,
            )
        )

        safety_ok = bool(
            data.get(
                "safety_ok",
                False,
            )
        )

        mission_active = bool(
            data.get(
                "mission_active",
                False,
            )
        )

        hold_active = bool(
            data.get(
                "hold_active",
                False,
            )
        )

        resume_allowed = bool(
            data.get(
                "resume_allowed",
                False,
            )
        )

        obstacle = str(
            data.get(
                "obstacle_state",
                "UNKNOWN",
            )
        )

        self.values[
            "online"
        ].setText(
            "ONLINE"
            if online
            else "OFFLINE"
        )

        self.style_indicator(
            self.values["online"],
            "good"
            if online
            else "bad",
        )

        safety_text = (
            "OK"
            if safety_ok
            else str(
                data.get(
                    "safety_state",
                    "UNKNOWN",
                )
            )
        )

        self.values[
            "safety"
        ].setText(
            safety_text
        )

        self.style_indicator(
            self.values["safety"],
            "good"
            if safety_ok
            else "bad",
        )

        self.values[
            "current_node"
        ].setText(
            str(
                data.get(
                    "current_node",
                    "",
                )
            )
            or "UNKNOWN"
        )

        self.values[
            "destination"
        ].setText(
            str(
                data.get(
                    "destination",
                    "",
                )
            )
            or "-"
        )

        mission_state = str(
            data.get(
                "mission_state",
                "UNKNOWN",
            )
        )

        self.values[
            "mission"
        ].setText(
            f"{mission_state} / "
            f"{'ACTIVE' if mission_active else 'IDLE'}"
        )

        self.values[
            "obstacle"
        ].setText(
            obstacle
        )

        obstacle_style = (
            "good"
            if obstacle == "CLEAR"
            else "warning"
            if obstacle == "WARNING"
            else "bad"
        )

        self.style_indicator(
            self.values["obstacle"],
            obstacle_style,
        )

        self.values[
            "hold"
        ].setText(
            "ACTIVE"
            if hold_active
            else "INACTIVE"
        )

        self.style_indicator(
            self.values["hold"],
            "warning"
            if hold_active
            else "good",
        )

        if reservation:
            path = reservation.get(
                "path",
                [],
            )

            self.values[
                "reservation"
            ].setText(
                " → ".join(path)
            )

            self.style_indicator(
                self.values[
                    "reservation"
                ],
                "blue",
            )

        else:
            self.values[
                "reservation"
            ].setText(
                "NONE"
            )

            self.style_indicator(
                self.values[
                    "reservation"
                ],
                "neutral",
            )

        pending = bool(
            data.get(
                "pending_destination",
                "",
            )
        )

        self.dispatch_button.setEnabled(
            online
            and safety_ok
            and bool(
                data.get(
                    "current_node",
                    "",
                )
            )
            and not mission_active
            and not hold_active
            and not reservation
            and not pending
        )

        self.cancel_button.setEnabled(
            mission_active
            or bool(reservation)
            or pending
        )

        self.resume_button.setEnabled(
            online
            and safety_ok
            and hold_active
            and resume_allowed
            and bool(reservation)
        )

        self.set_node_button.setEnabled(
            online
            and not mission_active
            and not reservation
            and not pending
        )


class FleetHMI(QMainWindow):
    def __init__(
        self,
        ros_node: FleetHMINode,
        config: dict,
    ) -> None:
        super().__init__()

        self.ros_node = ros_node
        self.config = config

        self.setWindowTitle(
            "Industrial AGV Fleet Control"
        )

        self.setMinimumSize(
            1280,
            820,
        )

        central_widget = QWidget()

        self.setCentralWidget(
            central_widget
        )

        main_layout = QVBoxLayout(
            central_widget
        )

        header_layout = QHBoxLayout()

        title = QLabel(
            "AGV FLEET CONTROL"
        )

        title.setObjectName(
            "mainTitle"
        )

        self.fleet_state_label = QLabel(
            "STARTING"
        )

        self.fleet_state_label.setObjectName(
            "fleetState"
        )

        self.clock_label = QLabel("--")

        header_layout.addWidget(
            title
        )

        header_layout.addStretch()

        mode_label = QLabel(
            "WHOLE-ROUTE TRAFFIC RESERVATION"
        )

        mode_label.setObjectName(
            "modeLabel"
        )

        header_layout.addWidget(
            mode_label
        )

        header_layout.addWidget(
            self.fleet_state_label
        )

        header_layout.addWidget(
            self.clock_label
        )

        main_layout.addLayout(
            header_layout
        )

        top_layout = QHBoxLayout()

        self.robot_cards: Dict[
            str,
            RobotCard,
        ] = {}

        all_nodes = list(
            config["nodes"].keys()
        )

        destination_nodes = [
            node_name
            for (
                node_name,
                node_info,
            ) in config[
                "nodes"
            ].items()
            if node_info.get(
                "type"
            ) in {
                "station",
                "home",
            }
        ]

        for robot_name in config[
            "robots"
        ]:
            card = RobotCard(
                robot_name,
                destination_nodes,
                all_nodes,
                self,
            )

            self.robot_cards[
                robot_name
            ] = card

            top_layout.addWidget(
                card
            )

        self.track_view = TrackView(
            config
        )

        top_layout.addWidget(
            self.track_view,
            2,
