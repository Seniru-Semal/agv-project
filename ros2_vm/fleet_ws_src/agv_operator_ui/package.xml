<?xml version="1.0"?>
<package format="3">
  <name>agv_operator_ui</name>
  <version>0.1.0</version>
  <description>PyQt5 operator GUIs for AGV supervisor, stores, and workbenches.</description>

  <maintainer email="seniru@example.com">seniru</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
